# Copy this file to .env and fill in your values.

# Required: your Discord bot token.
DISCORD_TOKEN=

# Optional: register slash commands instantly in one server (guild ID).
BOT_SYNC_GUILD_ID=

# Optional: route all YouTube traffic (resolver, yt-dlp, FFmpeg) through a proxy.
# On a VPS, YouTube blocks datacenter IPs ("Sign in to confirm you're not a bot").
# setup.sh installs Cloudflare WARP in proxy mode and sets this for you.
YOUTUBE_PROXY=http://127.0.0.1:40000

# Optional: set to 0 to search regular YouTube videos instead of YouTube Music songs.
YOUTUBE_MUSIC_SEARCH=1

# Optional: hours between automatic cookie refreshes (ytjs/cookie_refresher.mjs).
COOKIE_REFRESH_HOURS=6

# Optional: Spotify playback (/spotify). Each user brings their own Spotify
# Premium account and Client ID; nothing to set here for it to work.
# Path to go-librespot if not in ~/go-librespot/ or on PATH:
# GO_LIBRESPOT_BIN=
# How many Spotify players may run at once (each uses about 25-40MB of RAM):
# SPOTIFY_MAX_SESSIONS=2
# Minutes a paused/idle Spotify player stays alive:
# SPOTIFY_IDLE_MINUTES=5
